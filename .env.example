# Online rooms use Supabase Realtime broadcast (no tables). These are the *publishable* values: safe in the browser.
# Defaults are built in; set these only to point at a different Supabase project. Never put a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx
