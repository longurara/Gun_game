# Online rooms use Supabase for lobby/signaling only; gameplay uses WebRTC. No tables required.
# Defaults are built in; set these only to point at a different Supabase project. Never put a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Optional ICE servers as JSON. Default: Google's public STUN. No TURN is provisioned automatically.
# [] allows LAN-only tests without external ICE services.
# TURN credentials in a VITE variable are public. For public games, supply short-lived credentials instead.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:your-turn.example:3478"],"username":"temporary-user","credential":"temporary-password"}]
